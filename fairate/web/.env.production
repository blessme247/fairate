# The deployed UI is static assets on Cloudflare; the API is a long-running Node process on Render.
# Baked into the bundle at build time — without it the UI fetches /api/* from its own origin and the
# SPA fallback answers with index.html, which shows up as "API unreachable. Unexpected token '<'".
VITE_API_BASE_URL=https://fairate-api.onrender.com
