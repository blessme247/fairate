# Bridge example environment
# Convenience split from root `.env` — use the same CC3 Testnet values.

## Pre-deployed / network defaults (hello-bridge)
# Source chain key for Sepolia on CC3 Testnet (different from its chain ID, which is 11155111)
SOURCE_CHAIN_KEY=1
PROOF_BUILDER_URL="https://prover.cc3-testnet.creditcoin.network"
SOURCE_CHAIN_CONTRACT_ADDRESS="0x0F24FD9e0524BA53d3f0A4A40350Adf5370b4A53"
ASC_MINTER_CONTRACT_ADDRESS="0x2Be9B8640ED32815d3B9e8C92AbcD3F15F07396f"
ASC_MINTABLE_TOKEN="0x914Cf96BF28b7b4921db27b264ecEd71aC91134E" # betterleaks:allow
CREDITCOIN_RPC_URL="https://rpc.cc3-testnet.creditcoin.network"
EVM_V1_DECODER_LIBRARY_ADDRESS="0x04B9ae8562D8Cc5bbbBbBB759080dDC30B56D18B"

## User-provided
SOURCE_CHAIN_RPC_URL=""
CREDITCOIN_WALLET_PRIVATE_KEY=""

## User-deployed (custom-contracts-bridging + offchain worker)
SOURCE_CHAIN_CUSTOM_CONTRACT_ADDRESS=""
ASC_CUSTOM_MINTER_CONTRACT_ADDRESS=""
ASC_CUSTOM_MINTABLE_TOKEN=""

## Fairate contracts (Day 3-4) — see DEPLOYMENTS.md for the live testnet addresses
FAIRATE_SOURCE_STABLECOIN=""
FAIRATE_SOURCE_DEPOSIT=""
FAIRATE_ESCROW=""
FAIRATE_PAYOUT_TOKEN=""
FAIRATE_RATE_FEED=""
# Chainlink ETH/USD on Sepolia — public, no key needed
FAIRATE_CHAINLINK_FEED="0x694AA1769357215DE4FAC081bf1f309aDC325306"
FAIRATE_RATE_PUBLISHER=""

## Dedicated rate-publisher wallet — holds gas only, never admin rights.
## This is the ONLY secret the scheduled publish workflow needs.
PUBLISHER_PRIVATE_KEY=""
PUBLISHER_ADDRESS=""

## Optional: endpoint used only for scanning historical logs at API startup.
## eth_getLogs range limits are a billing-plan policy (Infura's free tier caps them at 10 blocks),
## so this defaults to a public endpoint that allows wide ranges. Read-only, no key needed.
FAIRATE_LOGS_RPC_URL=""

## Blocks the corridor contracts were deployed at — bounds the startup log scan.
## Without them the API falls back to a rolling lookback, which eventually misses early transfers.
FAIRATE_DEPOSIT_DEPLOY_BLOCK=""
FAIRATE_ESCROW_DEPLOY_BLOCK=""
